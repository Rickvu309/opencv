                                },
                                {
                                  "type": "text",
                                  "id": "MwNFs",
                                  "x": 0,
                                  "y": 0,
                                  "name": "or via the chat box in our Help Center. ",
                                  "enabled": false,
                                  "fill": "#161b1d",
                                  "textGrowth": "fixed-width",
                                  "width": 1276.65,
                                  "content": "or via the chat box in our Help Center. We aim to respond within 24 hours on weekdays (a bit longer on weekends and holidays).\n\nPlease include as much information as possible: links, screenshots, payment references, etc.",
                                  "lineHeight": 1.6,
