                                                            },
                                                            {
                                                              "type": "text",
                                                              "id": "kHNwX",
                                                              "name": "• Built Rezi - the most loved resume sof",
                                                              "context": "p",
                                                              "fill": "#545454",
                                                              "content": "• Built Rezi - the most loved resume software in the world, trusted by over 2,227,254 users.",
                                                              "lineHeight": 1.55,
                                                              "fontFamily": "Inter Variable",
                                                              "fontSize": 9.57,
                                                              "fontWeight": "450",
                                                              "letterSpacing": -0.14
                                                            },
                                                            {
                                                              "type": "frame",
                                                              "id": "uHBAZ",
                                                              "name": "spacer",
                                                              "width": "fill_container",
                                                              "height": 1.99,
                                                              "layout": "none"
                                                            },
                                                            {
                                                              "type": "text",
                                                              "id": "KR5bS",
                                                              "name": "• Founded Rezi at the age of 22. At 23, ",
                                                              "context": "p",
                                                              "fill": "#545454",
                                                              "textGrowth": "fixed-width-height",
                                                              "width": "fill_container",
                                                              "height": 29.66,
                                                              "content": "• Founded Rezi at the age of 22. At 23, successfully globalized into South Korea growing to be South Korea's leading English resume company, the most awarded global startup in South Korea, and securing over $650,000 in investment, grants, and awards.",
                                                              "lineHeight": 1.55,
                                                              "fontFamily": "Inter Variable",
                                                              "fontSize": 9.57,
                                                              "fontWeight": "450",
                                                              "letterSpacing": -0.14
                                                            },
                                                            {
                                                              "type": "frame",
                                                              "id": "rAlCP",
                                                              "name": "spacer",
                                                              "width": "fill_container",
                                                              "height": 1.99,
                                                              "layout": "none"
                                                            },
                                                            {
                                                              "type": "text",
                                                              "id": "M9I1oZ",
                                                              "name": "• Collaborated with the development team",
                                                              "context": "p",
                                                              "fill": "#545454",
                                                              "textGrowth": "fixed-width-height",
                                                              "width": "fill_container",
                                                              "height": 29.66,
                                                              "content": "• Collaborated with the development team to engineer scalable partnership strategies such as redemption-code-based access which resulted in over 50,000 new users in 1 month with zero marketing dollars spent.",
                                                              "lineHeight": 1.55,
                                                              "fontFamily": "Inter Variable",
                                                              "fontSize": 9.57,
                                                              "fontWeight": "450",
                                                              "letterSpacing": -0.14
                                                            },
                                                            {
                                                              "type": "frame",
                                                              "id": "fuiNH",
                                                              "name": "spacer",
                                                              "width": "fill_container",
                                                              "height": 1.99,
                                                              "layout": "none"
                                                            },
                                                            {
                                                              "type": "text",
                                                              "id": "ZbpOX",
                                                              "name": "• Accountable for developing new busines",
                                                              "context": "p",
                                                              "fill": "#545454",
                                                              "textGrowth": "fixed-width-height",
                                                              "width": "fill_container",
                                                              "height": 29.66,
                                                              "content": "• Accountable for developing new business models as a response towards market conditions and opportunities which resulted in the development of 3 new core departments including e-learning, global recruiting, and data-vending.",
                                                              "lineHeight": 1.55,
                                                              "fontFamily": "Inter Variable",
                                                              "fontSize": 9.57,
                                                              "fontWeight": "450",
                                                              "letterSpacing": -0.14
