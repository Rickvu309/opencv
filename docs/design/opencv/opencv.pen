                                {
                                  "type": "frame",
                                  "id": "i8WdP",
                                  "name": "How does Enhancv use AI?",
                                  "context": "TextPrimitive - h6",
                                  "height": 44,
                                  "layout": "vertical",
                                  "padding": [
                                    0,
                                    0,
                                    16,
                                    0
                                  ],
                                  "justifyContent": "center",
                                  "children": [
                                    {
                                      "type": "text",
                                      "id": "dtBiZ",
                                      "fill": "#161b1d",
                                      "content": "How does Enhancv use AI?",
                                      "lineHeight": 1.27,
                                      "fontFamily": "Rubik",
                                      "fontSize": 22,
                                      "fontWeight": "normal"
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "type": "frame",
                              "id": "bzREV",
                              "x": 0,
                              "y": 0,
                              "name": "div",
                              "context": "div",
                              "enabled": false,
                              "width": "fill_container(1296)",
                              "height": 169.56,
                              "layout": "vertical",
                              "gap": 19.09,
                              "padding": [
                                3,
                                0,
                                0,
                                0
                              ],
                              "children": [
                                {
                                  "type": "text",
                                  "id": "MUgVD",
                                  "x": 0,
                                  "y": 0,
                                  "name": "Enhancv uses AI to do the heavy lifting ",
                                  "enabled": false,
                                  "fill": "#161b1d",
                                  "textGrowth": "fixed-width",
                                  "width": 1293.44,
                                  "content": "Enhancv uses AI to do the heavy lifting on your resume while you stay in control of every word. Rather than one generic model, it runs on a mix of the best models available (OpenAI, Claude, Gemini, and Deepseek), hosted in the EU, with a proprietary system that picks the right one for each task. What makes the difference is what's built on top: prompts trained by our in-house Certified Professional Resume Writers. Here's how that plays out:",
                                  "lineHeight": 1.6,
                                  "fontFamily": "Inter",
                                  "fontSize": 16,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "frame",
                                  "id": "zm8C4",
                                  "x": 0,
                                  "y": 0,
                                  "name": "ul",
                                  "context": "ul",
                                  "enabled": false,
                                  "width": "fill_container(1296)",
                                  "height": "fit_content(76.78)",
                                  "layout": "vertical",
                                  "gap": 0.01,
                                  "padding": [
                                    0,
                                    0,
                                    0,
                                    24
                                  ],
                                  "children": [
                                    {
                                      "type": "frame",
                                      "id": "n3lAK",
                                      "x": 0,
                                      "y": 0,
                                      "name": "li",
