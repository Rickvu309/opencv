#!/usr/bin/env bash
# pre-commit: keep authored files small enough for an agent to read in one pass.
#   - rejects a commit when a staged file is over 5000 tokens (tokens = bytes / 4, so 20000 bytes)
#   - size is the staged blob, not the working-tree file
#   - skips deletions, submodules, binary files (NUL in the staged blob) and files marked linguist-generated
#     in .gitattributes, which is the only place that lists machine-written files
set -euo pipefail

limit_tokens=5000
limit_bytes=$((limit_tokens * 4))
part_tokens=4000

# One source for path and blob id, so a path like "1:big.ts" is never parsed as a revision.
declare -A blob_sha=() blob_bytes=() generated=()
over=()
while IFS= read -r -d '' meta && IFS= read -r -d '' path; do
  read -r _ newmode _ sha _ <<<"${meta#:}"
  [[ "$newmode" == 160000 ]] && continue
  bytes=$(git cat-file -s "$sha")
  if (( bytes > limit_bytes )); then
    over+=("$path")
    blob_sha["$path"]=$sha
    blob_bytes["$path"]=$bytes
  fi
done < <(git diff --cached --no-renames --raw --no-abbrev -z --diff-filter=ACMR)

if (( ${#over[@]} == 0 )); then
  exit 0
fi

# --cached reads the staged .gitattributes, so adding a pattern and the file in one commit works.
while IFS= read -r -d '' path && IFS= read -r -d '' _attr && IFS= read -r -d '' value; do
  if [[ "$value" == set || "$value" == true ]]; then
    generated["$path"]=1
  fi
done < <(printf '%s\0' "${over[@]}" | git check-attr --cached -z --stdin linguist-generated)

# Git's own heuristic: a NUL in the first 8000 bytes. Not the -diff attribute, which the worktree can set.
# Every blob here is over 8000 bytes, so a text blob keeps all 8000 bytes after tr drops the NULs.
is_binary() {
  local kept
  kept=$(head -c 8000 < <(git cat-file blob "$1") | tr -d '\0' | wc -c)
  (( kept < 8000 ))
}

report=""
count=0
for path in "${over[@]}"; do
  [[ -n "${generated["$path"]:-}" ]] && continue
  is_binary "${blob_sha["$path"]}" && continue
  bytes=${blob_bytes["$path"]}
  tokens=$(( (bytes + 3) / 4 ))
  parts=$(( (tokens + part_tokens - 1) / part_tokens ))
  report+="  $path: $tokens tokens ($bytes bytes), limit $limit_tokens tokens ($limit_bytes bytes). Split into at least $parts parts."$'\n'
  count=$((count + 1))
done

if (( count == 0 )); then
  exit 0
fi

{
  echo "pre-commit: $count staged file(s) over the $limit_tokens token limit:"
  printf '%s' "$report"
  cat <<'MSG'

How to split (follow in order):
1. Split by responsibility, not by line count. Find the seams: groups of functions or types that change together, one component per file, one concern per module.
2. Code (.ts, .tsx, .js, .mjs): move each group into a sibling module in the same folder, for example build.ts into build/geometry.ts and build/materials.ts, or build-geometry.ts. Keep the original path as the public entry point that re-exports, or update every import. Run pnpm typecheck after.
3. Tests (*.test.ts, *.test.tsx): split by top-level describe block into <name>.<topic>.test.ts. Move shared fixtures and helpers into <name>.fixtures.ts (or a test helper module) that each part imports.
4. Markdown docs: split by ## section into a folder <name>/ with an index file that links each part.
5. CSS: split by component or section into separate files imported from the original.
6. JSON and data: split by top-level key into separate files, or load the data at runtime instead of inlining it.
7. Do not minify, strip comments, or shorten names to get under the limit. Do not add an authored file to .gitattributes. Only machine-written output (lockfiles, codegen, design exports) belongs there, marked linguist-generated.
8. Re-stage the new files and commit again.
MSG
} >&2
exit 1
