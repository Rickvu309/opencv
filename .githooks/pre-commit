#!/usr/bin/env bash
# pre-commit: format staged files, then the rule table's commit rows over them (file size).
# Enable once per clone:  git config core.hooksPath .githooks. Logic and rules: scripts/ocv-tools/jobs/hook.mjs.
command -v node >/dev/null 2>&1 || { echo "pre-commit: node is not on PATH; install node 20 or newer." >&2; exit 1; }
exec node "$(git rev-parse --show-toplevel)/scripts/ocv-tools.mjs" hook pre-commit "$@"
