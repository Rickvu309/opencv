#!/usr/bin/env bash
# pre-push: local guardrails (CI runs parallel affected jobs). Enable once per clone:  git config core.hooksPath .githooks
#   1. Never push to main (or delete it).
#   2. Branch names must be type/<issue#>-short-description.
#   3. Run `pnpm check` (node scripts/check.mjs): a quick lint/typecheck/test scoped to what changed since origin/main.
#      CI runs affected jobs and guards; pnpm check:full covers every package.
#
# Emergency only, discouraged: SKIP_CHECKS=1 git push ...   skips step 3 (rules 1-2 still apply).
# `git push --no-verify` skips this hook entirely. Never use it. A skipped hook is not caught again at merge.
set -euo pipefail

BRANCH_RE='^(feat|fix|hotfix|refactor|chore|docs)/[0-9]+-[a-z0-9]+(-[a-z0-9]+)*$'
BOT_RE='^(dependabot|renovate)/'
ZERO=0000000000000000000000000000000000000000

fail() { echo "pre-push: $*" >&2; exit 1; }

run_checks=0
shas=()
# Record each pushed sha as "ok" or "skip" in the clone's git dir (shared by its worktrees). Nothing reads
# these stamps. "skip" is a SKIP_CHECKS=1 push.
stamp() {
  local dir s
  dir="$(git rev-parse --path-format=absolute --git-common-dir)/pre-push-stamps"
  mkdir -p "$dir" 2>/dev/null || return 0
  for s in "${shas[@]}"; do echo "$1" >"$dir/$s" 2>/dev/null || true; done
}

while read -r _local_ref local_sha remote_ref _remote_sha; do
  [[ -n "${remote_ref:-}" ]] || continue
  case "$remote_ref" in
    refs/heads/*)
      branch=${remote_ref#refs/heads/}
      if [[ "$branch" == "main" ]]; then
        fail "pushing to main is not allowed. Push your task branch and open a PR (scripts/ocv-tools.mjs finish)."
      fi
      # Deleting a remote task branch is fine.
      [[ "$local_sha" =~ ^0+$ || "$local_sha" == "$ZERO" ]] && continue
      if [[ ! "$branch" =~ $BRANCH_RE && ! "$branch" =~ $BOT_RE ]]; then
        fail "branch '$branch' does not match type/<issue#>-short-description (e.g. feat/42-login-page).
Types: feat, fix, hotfix, refactor, chore, docs. See docs/git-workflow/branch-naming.md."
      fi
      run_checks=1
      shas+=("$local_sha")
      ;;
    refs/tags/*) ;;  # version tags (vX.Y.Z) are allowed
    *) ;;
  esac
done

(( run_checks )) || exit 0

if [[ "${SKIP_CHECKS:-}" == "1" ]]; then
  echo "pre-push: WARNING: SKIP_CHECKS=1, the quick check is skipped. Emergencies only; say so in the PR." >&2
  stamp skip
  exit 0
fi

top=$(git rev-parse --show-toplevel)
if [[ ! -f "$top/scripts/check.mjs" ]]; then
  fail "scripts/check.mjs not found; restore the check runner before pushing."
fi
command -v pnpm >/dev/null 2>&1 || fail "pnpm is not on this shell's PATH, so the quick check cannot run. Install it (corepack enable) or push from a shell that has it."
if [[ -n "$(git status --porcelain --untracked-files=no)" ]]; then
  echo "pre-push: note: you have uncommitted changes; checks run on the working tree, not only on what you push." >&2
fi
echo "pre-push: running pnpm check (quick check of what changed)..." >&2
(cd "$top" && env -u CHECK_DRY_RUN pnpm check) || fail "checks failed. Fix them before pushing."
stamp ok
