#!/usr/bin/env bash
# commit-msg: the rule table's commit rows over the message (not on main, a first line, no attribution trailer).
# Enable once per clone:  git config core.hooksPath .githooks. Logic and rules: scripts/ocv-tools/jobs/hook.mjs.
command -v node >/dev/null 2>&1 || { echo "commit-msg: node is not on PATH; install node 20 or newer." >&2; exit 1; }
exec node "$(git rev-parse --show-toplevel)/scripts/ocv-tools.mjs" hook commit-msg "$@"
