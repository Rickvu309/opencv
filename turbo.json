{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "turbo.json",
    "tsconfig.json",
    ".npmrc",
    ".nvmrc",
    ".node-version",
    ".pnpmfile.cjs",
    "vitest.*",
    "scripts/check.mjs",
    ".railway/railway.ts",
    ".gitattributes",
    "*.config.*",
    "tsconfig*.json",
    ".eslint*",
    ".prettier*"
  ],
  "globalEnv": ["VITEST_MAX_WORKERS"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "//#catalog:check"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["VITE_API_URL", "VITE_PUBLIC_ORIGIN", "VITE_APP_ORIGIN"],
      "outputs": ["dist/**", ".generated/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^build", "//#catalog:check"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@workspace/guards#test": {
      "cache": false
    },
    "test:open-pr": {
      "cache": false
    },
    "test:formal": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["VITEST_MAX_WORKERS", "FORMAL_DATABASE_URL"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "passThroughEnv": ["VITEST_MAX_WORKERS"],
      "outputs": []
    },
    "//#catalog:check": {
      "cache": false,
      "inputs": [
        "scripts/catalog.mjs",
        "scripts/lib/**",
        "packages/domain/src/**",
        "apps/api/src/**"
      ],
      "outputs": []
    }
  },
  "futureFlags": {
    "affectedUsingTaskInputs": true
  }
}
