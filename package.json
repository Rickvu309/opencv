{
  "name": "openpath",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "generate:routes": "node --input-type=module -e \"import { Generator, getConfig } from '@tanstack/router-generator'; const config = getConfig({ target: 'react', routesDirectory: './src/routes', generatedRouteTree: './src/routeTree.gen.ts', disableLogging: true }, process.cwd()); await new Generator({ config, root: process.cwd() }).run();\"",
    "build": "npm run typecheck && vite build",
    "start": "node --import ./scripts/alias-hook.mjs --env-file-if-exists=.env.local scripts/web-start.mjs",
    "worker": "node --import ./scripts/alias-hook.mjs --env-file-if-exists=.env.local scripts/worker.mjs",
    "lint": "eslint .",
    "test": "node --import ./scripts/alias-hook.mjs --env-file-if-exists=.env.local --test \"src/**/*.test.ts\"",
    "db:migrate": "node --import ./scripts/alias-hook.mjs --env-file-if-exists=.env.local scripts/db.mjs up",
    "db:rollback": "node --import ./scripts/alias-hook.mjs --env-file-if-exists=.env.local scripts/db.mjs down",
    "db:status": "node --import ./scripts/alias-hook.mjs --env-file-if-exists=.env.local scripts/db.mjs status"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.21",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@tanstack/react-form": "^1.27.0",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-router": "^1.132.0",
    "@tanstack/react-start": "^1.132.0",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/og": "^0.8.5",
    "ai": "^7.0.66",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.542.0",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@fontsource/be-vietnam-pro": "^5.2.8",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^24.3.1",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "nitro": "npm:nitro-nightly@latest",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.5",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "engines": {
    "node": "24.x"
  }
}
