{
  "name": "openpath",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import ./scripts/alias-hook.mjs --env-file-if-exists=.env.local --test \"lib/**/*.test.ts\" \"agent/**/*.test.ts\"",
    "db:migrate": "node --import ./scripts/alias-hook.mjs --env-file-if-exists=.env.local scripts/db.mjs up",
    "db:rollback": "node --import ./scripts/alias-hook.mjs --env-file-if-exists=.env.local scripts/db.mjs down",
    "db:status": "node --import ./scripts/alias-hook.mjs --env-file-if-exists=.env.local scripts/db.mjs status"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.21",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@vercel/blob": "^2.6.1",
    "@vercel/connect": "0.4.3",
    "ai": "^7.0.38",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "eve": "^0.29.5",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.16.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": "24.x"
  }
}
