{
  "name": "opencv",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "node scripts/catalog.mjs check && turbo build",
    "dev": "node scripts/catalog.mjs check && turbo dev",
    "lint": "turbo lint && pnpm lint:design",
    "format": "turbo format",
    "typecheck": "node scripts/catalog.mjs check && turbo typecheck",
    "catalog:generate": "node scripts/catalog.mjs generate",
    "catalog:check": "node scripts/catalog.mjs check",
    "test": "turbo test test:open-pr",
    "check": "node scripts/check.mjs",
    "check:full": "node scripts/check.mjs --full",
    "test:formal": "node scripts/tlc.mjs --all",
    "lint:design": "oxlint apps/web/src packages/ui/src"
  },
  "devDependencies": {
    "fontkit": "^2.0.4",
    "outtrue": "^0.2.0",
    "oxlint": "^1.95.0",
    "playwright-core": "1.65.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "railway": "^3.16.0",
    "ts-packwerk": "0.1.3",
    "turbo": "^2.11.9",
    "typescript": "~6"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.16"
  }
}
