{
  "name": "openpath",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "start": "node .output/server/index.mjs",
    "lint": "eslint",
    "test": "node --import ./scripts/alias-hook.mjs --env-file-if-exists=.env.local --test \"src/lib/**/*.test.ts\" \"agent/**/*.test.ts\"",
    "db:migrate": "node --import ./scripts/alias-hook.mjs --env-file-if-exists=.env.local scripts/db.mjs up",
    "db:rollback": "node --import ./scripts/alias-hook.mjs --env-file-if-exists=.env.local scripts/db.mjs down",
    "db:status": "node --import ./scripts/alias-hook.mjs --env-file-if-exists=.env.local scripts/db.mjs status"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.21",
    "@ai-sdk/provider": "4.0.5",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@tanstack/react-db": "^0.2.1",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.29",
    "@tanstack/react-start": "^1.168.46",
    "@tanstack/react-table": "^9.1.2",
    "@vercel/og": "^1.0.1",
    "ai": "^7.0.38",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eve": "^0.29.5",
    "lucide-react": "^1.28.0",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.16.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9",
    "nitro": "^3.0.260610-beta",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "engines": {
    "node": "24.x"
  }
}
