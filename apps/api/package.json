{
  "name": "api",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch --conditions=opencv-source src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "migrate": "node dist/migrate.js",
    "seed": "node dist/seed.js",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx src/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:formal": "vitest run --config vitest.formal.config.ts",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.135",
    "@hono/node-server": "^2.1.5",
    "@openrouter/ai-sdk-provider": "^2.9.1",
    "@workspace/domain": "workspace:*",
    "ai": "^6.0.266",
    "better-auth": "^1.7.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.7",
    "@eslint/js": "^10",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10",
    "fast-check": "^4.10.2",
    "globals": "^17",
    "tsx": "^4.23.15",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vitest": "^5.0.5"
  }
}
