{
  "name": "api",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "hono": "^4.12.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsx": "^4.21.0",
    "typescript": "~6",
    "vitest": "^3.2.4"
  }
}
