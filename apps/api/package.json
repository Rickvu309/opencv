{
  "name": "api",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/catalog.mjs dev -- pnpm --dir apps/api exec tsx watch --conditions=opencv-source --env-file-if-exists=../../.env src/index.ts",
    "build": "node ../../scripts/catalog.mjs check && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "migrate": "node dist/migrate.js",
    "seed": "node dist/seed.js",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx --conditions=opencv-source src/seed.ts",
    "typecheck": "node ../../scripts/catalog.mjs check && tsc --noEmit && tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "test:formal": "vitest run --config vitest.formal.config.ts",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "test:mcp-harness": "node --test src/test/mcp-harness.integration.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@better-auth/cimd": "1.7.14",
    "@better-auth/oauth-provider": "1.7.14",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/hono": "2.0.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@workspace/domain": "workspace:*",
    "@workspace/paper-crdt": "workspace:*",
    "@workspace/paper-engine": "workspace:*",
    "@xmldom/xmldom": "0.8.15",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "mammoth": "1.13.0",
    "pdfkit": "0.21.0",
    "pg": "^8.23.1",
    "unpdf": "1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.7",
    "@eslint/js": "^10",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/inspector": "2.14.0",
    "@types/node": "^24",
    "@types/pdfkit": "0.17.7",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10",
    "fast-check": "^4.10.2",
    "globals": "^17",
    "tsx": "^4.23.15",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vitest": "^5.0.5",
    "yjs": "13.6.33"
  }
}
