{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "customConditions": [],
    "outDir": "dist",
    "declaration": false,
    "sourceMap": true
  },
  "exclude": [
    "src/**/test/**",
    "src/**/*.test.ts",
    "src/**/*.type-test.ts",
    "src/**/*.test-support.ts",
    "src/**/*fixtures.ts",
    "src/**/*-fixture.ts",
    "src/**/*.support.ts"
  ]
}
