{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    // Empty so the emitted api imports the built domain package, not its source.
    "customConditions": [],
    "outDir": "dist",
    "declaration": false,
    "sourceMap": true
  },
  "exclude": [
    "src/**/*.test.ts",
    "src/auth.fixtures.ts",
    "src/paper/client-sync-property.ts",
    "src/paper/client-sync-races.ts",
    "src/paper/client-sync-shapes.ts",
    "src/paper/photo.fixtures.ts",
    "src/paper/photo-lifetime.support.ts"
  ]
}
