{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "test:assumptions": "vitest run --config vitest.config.ts src/test/verify-assumptions.test.ts",
    "test": "vitest run --config vitest.config.ts",
    "verify:marketing": "vitest run --config vitest.config.ts src/test/marketing/marketing-links.verify.test.tsx src/test/marketing/help-filter.property.test.ts",
    "verify:landing": "node ../../.claude/skills/verify-landing/scripts/verify-landing.mjs",
    "verify:app-ui": "node ../../.claude/skills/verify-app-ui/scripts/verify-app-ui.mjs",
    "verify:pen-layout": "node ../../.claude/skills/verify-app-ui/scripts/verify-pen-layout.mjs",
    "verify:apply-pen": "node ../../.claude/skills/verify-app-ui/scripts/verify-apply-pen.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "@workspace/domain": "workspace:*",
    "@workspace/ui": "workspace:*",
    "better-auth": "^1.7.7",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@tailwindcss/vite": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fast-check": "4.10.2",
    "globals": "^17",
    "jsdom": "^27.0.1",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8.1.6",
    "vitest": "^5.0.5"
  }
}
