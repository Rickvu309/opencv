{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "verify:marketing": "vitest run --config vitest.config.ts src/test/marketing/marketing-links.verify.test.tsx src/test/marketing/help-filter.property.test.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "@workspace/domain": "workspace:*",
    "@workspace/paper-corpus": "workspace:*",
    "@workspace/paper-engine": "workspace:*",
    "@workspace/stageshow": "workspace:*",
    "@workspace/ui": "workspace:*",
    "better-auth": "^1.7.7",
    "lucide-react": "^1.60.0",
    "prosemirror-model": "1.25.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.7",
    "use-effect-reducer": "0.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@tailwindcss/vite": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "6.2.7",
    "fast-check": "4.10.2",
    "globals": "^17",
    "jsdom": "^27.0.1",
    "playwright-core": "1.65.0",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8.1.6",
    "vitest": "^5.0.5"
  }
}
