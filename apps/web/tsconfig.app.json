{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"],
      "@workspace/domain/internal/paper-page-scale": [
        "../../packages/domain/src/paper-doc/paper-page-scale.ts"
      ],
      "@workspace/domain/internal/paper-presentation": [
        "../../packages/domain/src/paper-doc/paper-presentation.ts"
      ],
      "@workspace/domain/*": ["../../packages/domain/src/*/public.ts"],
      "@workspace/paper-crdt": ["../../packages/paper-crdt/src/index.ts"],
      "@workspace/ui/*": ["../../packages/ui/src/*"],
      "@workspace/stageshow/*": ["../../packages/stageshow/src/*"]
    }
  },
  "include": [
    "src",
    "../../packages/paper-engine/src/layout/vendor-types.d.ts"
  ],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test"]
}
