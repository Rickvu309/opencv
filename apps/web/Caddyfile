{
	auto_https off
	admin off
}

:{$PORT:8080} {
	root * /srv
	encode gzip

	@legacyApp {
		host opencv.me www.opencv.me
		path /app /app/* /sign-in /sign-up
	}
	@appHome {
		host app.opencv.me
		path /
	}
	@appPitch {
		host app.opencv.me
		path /u/*
	}
	@publicPitchApi {
		host opencv.me www.opencv.me
		method GET
		path /api/pitch/public/*
	}
	@appApi {
		host app.opencv.me
		path /api /api/*
	}
	@apiPath path /api /api/*

	route {
		handle /health {
			respond "ok" 200
		}

		handle @legacyApp {
			redir https://app.opencv.me{uri} 308
		}
		handle @appHome {
			@withQuery expression {query} != ""
			redir @withQuery /app?{query} 302
			redir * /app 302
		}
		handle @appPitch {
			redir https://opencv.me{uri} 308
		}
		handle @publicPitchApi {
			reverse_proxy {$API_UPSTREAM:http://api.railway.internal:3001} {
				header_up -Cookie
				header_up -Authorization
				header_down -Set-Cookie
			}
		}
		handle @appApi {
			reverse_proxy {$API_UPSTREAM:http://api.railway.internal:3001} {
				flush_interval -1
			}
		}
		handle @apiPath {
			respond 404
		}

		handle /assets/* {
			header {
				Cache-Control "public, max-age=31536000, immutable"
				match status 2xx
			}
			file_server
		}

		handle {
			header Cache-Control "no-cache"
			try_files {path} /index.html
			file_server
		}
	}
}
