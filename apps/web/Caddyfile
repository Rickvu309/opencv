{
	auto_https off
	admin off
}

:{$PORT:8080} {
	root * /srv
	encode gzip

	handle /health {
		respond "ok" 200
	}

	handle /version.txt {
		header Cache-Control "no-store"
		file_server
	}

	handle /assets/* {
		header {
			Cache-Control "public, max-age=31536000, immutable"
			match status 2xx
		}
		file_server
	}

	import host-routing.caddy

	handle {
		header Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
