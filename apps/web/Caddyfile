{
	auto_https off
	admin off
}

:{$PORT:8080} {
	root * /srv
	encode gzip

	handle /health {
		respond "ok" 200
	}

	# try_files rewrites deep links to /index.html after header matchers run,
	# so index.html is every path that is not a hashed asset.
	handle {
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		@pages not path /assets/*
		header @pages Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
