{
  "name": "@workspace/paper-crdt",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "opencv-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@blocknote/core": "0.57.0",
    "@tiptap/pm": "3.32.2",
    "@workspace/domain": "workspace:*",
    "dompurify": "3.4.18",
    "fast-diff": "1.3.0",
    "y-prosemirror": "1.3.7",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^24",
    "eslint": "^10",
    "fast-check": "^4.10.2",
    "globals": "^17",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vitest": "^5.0.5"
  }
}
