{
  "name": "@workspace/paper-engine",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "opencv-source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "replay": "vitest run src/audit-replay.test.ts --silent=false --reporter=dot",
    "simulate": "vitest run src/two-tabs.model.test.ts --silent=false -t compaction"
  },
  "dependencies": {
    "@workspace/domain": "workspace:*",
    "prosemirror-collab": "1.3.1",
    "prosemirror-history": "1.5.1",
    "prosemirror-model": "1.25.12",
    "prosemirror-state": "1.4.4",
    "prosemirror-transform": "1.12.4"
  },
  "devDependencies": {
    "@types/node": "^24",
    "fast-check": "4.10.2",
    "typescript": "~6",
    "vitest": "^5.0.5"
  }
}
