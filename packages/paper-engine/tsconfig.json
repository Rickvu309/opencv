{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "outDir": "dist",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "customConditions": ["opencv-source"],
    "resolveJsonModule": true
  },
  "include": ["src", "cli", "vitest.config.ts"]
}
