{
  "name": "@workspace/domain",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    "./internal/paper-presentation": {
      "opencv-source": "./src/paper-doc/paper-presentation.ts",
      "types": "./dist/paper-doc/paper-presentation.d.ts",
      "import": "./dist/paper-doc/paper-presentation.js"
    },
    "./operations/*": {
      "opencv-source": "./src/operations/*/operation.ts",
      "types": "./dist/operations/*/operation.d.ts",
      "import": "./dist/operations/*/operation.js"
    },
    "./*": {
      "opencv-source": "./src/*/public.ts",
      "types": "./dist/*/public.d.ts",
      "import": "./dist/*/public.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/catalog.mjs check && tsc -p tsconfig.build.json",
    "typecheck": "node ../../scripts/catalog.mjs check && tsc --noEmit",
    "test": "node --experimental-strip-types --import ./register-ts.mjs --test src/*.test.ts",
    "lint": "eslint",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "eslint": "^10",
    "fast-check": "4.10.2",
    "globals": "^17",
    "typescript": "~6",
    "typescript-eslint": "^8"
  }
}
