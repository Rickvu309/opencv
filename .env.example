# Copy to `.env` or `.env.local`. Nothing here is a secret — fill real values
# locally and set the same names in Railway. See docs/deploy.md.

# ---------------------------------------------------------------------------
# Web (Vite): baked in at build time, so the Railway `web` service sets it per
# environment (.railway/railway.ts): production -> api.opencv.me, staging ->
# api-staging.opencv.me. See docs/deploy.md.
# ---------------------------------------------------------------------------
# Unset locally: derived from PORT (api on PORT, web dev server on PORT + 1000).
# VITE_API_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# API process
# ---------------------------------------------------------------------------
# `pnpm dev` loads this file. PORT is the api port; the web dev server uses
# PORT + 1000, and the web's API URL, WEB_ORIGINS and AUTH_URL default from it.
# Unset keeps the api on 3001 and the web on 5173. scripts/new-task.sh sets it per worktree.
# PORT=3001

# Browser origins the API accepts cross-host calls from (comma-separated).
# An entry may contain one `*`, which matches a single DNS label. Unset = the
# local web dev server derived from PORT. See docs/deploy.md.
# WEB_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Postgres (Railway / local)
# Optional for GET /health and local `pnpm dev`.
# Required to apply migrations (`pnpm --filter api run migrate` / Railway
# preDeploy) and to seed (`pnpm --filter api run seed`).
# App tables live in the `opencv_app` schema.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:pass@localhost:5432/opencv
#
# On Railway the api service gets DATABASE_URL via the shared reference
# DATABASE_URL=${{Postgres.DATABASE_URL}} (no credentials in git).

# ---------------------------------------------------------------------------
# Auth (Better Auth on the API)
# SESSION_SECRET must be at least 32 characters (`openssl rand -base64 32`).
# AUTH_URL is this API's public URL — https makes cookies SameSite=None; Secure.
# Railway sets both per environment. Sign-in is a 6-digit code. Resend sends
# it when both mail values are set. Otherwise the api logs the code.
# Google sign-in is on only when both Google values are set.
# ---------------------------------------------------------------------------
# SESSION_SECRET=
# AUTH_URL=http://localhost:3001
# RESEND_API_KEY=
# AUTH_EMAIL_FROM=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Dev / staging seed (same starter workspace as signup; never on preDeploy)
# If SEED_EMAIL already exists, the script fills an empty account.
# If it does not, SEED_PASSWORD + SESSION_SECRET create it first.
# See docs/deploy.md#seed-and-local-commands.
# ---------------------------------------------------------------------------
# SEED_EMAIL=dev@opencv.me
# SEED_PASSWORD=correct-horse-battery
# SEED_NAME=Dev

# ---------------------------------------------------------------------------
# Coach. Free routes through OpenRouter. Pro routes through Anthropic.
# Missing keys: the app boots and a live turn returns 503. COACH_RUNTIME=fake
# uses the scripted runtime and calls no provider. Never set it on production.
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=
# COACH_MODEL_FREE=openrouter/free
# COACH_MODEL_PRO_FREE=claude-haiku-5-5
# COACH_MODEL_LIGHT=claude-sonnet-5-5
# COACH_MODEL_MAX=claude-opus-5-5
# COACH_DAILY_TURN_LIMIT_FREE=20
# COACH_DAILY_TURN_LIMIT_PRO_FREE=0
# COACH_DAILY_TURN_LIMIT_LIGHT=10
# COACH_DAILY_TURN_LIMIT_MAX=5
# COACH_SESSION_HOURS=4
# COACH_RUNTIME=fake
# GMAIL_ENABLED=false
# INBOX_FIXTURE=
# MAIL_PROVIDER=fake
