# Copy to `.env` or `.env.local`. Nothing here is a secret — fill real values
# locally and set the same names in Railway. See docs/deploy.md.

# ---------------------------------------------------------------------------
# Web: optional local API override. Production uses the same-origin Caddy proxy.
# Railway web: API_UPSTREAM=http://api.railway.internal:3001
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# API process
# ---------------------------------------------------------------------------
PORT=3001

# Browser origins the API accepts cross-host calls from (comma-separated).
# An entry may contain one `*`, which matches a single DNS label. Unset = local
# web only. See docs/deploy.md.
WEB_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Postgres (Railway / local)
# Optional for GET /health and local `pnpm dev`.
# Required to apply migrations (`pnpm --filter api run migrate` / Railway
# preDeploy) and to seed (`pnpm --filter api run seed`).
# App tables live in the `openpath_app` schema.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:pass@localhost:5432/opencv
#
# On Railway the api service gets DATABASE_URL via the shared reference
# DATABASE_URL=${{Postgres.DATABASE_URL}} (no credentials in git).

# ---------------------------------------------------------------------------
# Auth (Better Auth on the API)
# SESSION_SECRET must be at least 32 characters (`openssl rand -base64 32`).
# AUTH_URL is the browser-facing auth origin: https://app.opencv.me in production.
# HTTPS cookies are Secure, HttpOnly, host-only and SameSite=Lax.
# Set production WEB_ORIGINS=https://app.opencv.me. Reset mail is not delivered
# by the current production auth configuration.
# ---------------------------------------------------------------------------
# SESSION_SECRET=
# AUTH_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Dev / staging seed (same starter workspace as signup; never on preDeploy)
# If SEED_EMAIL already exists, the script fills an empty account.
# If it does not, SEED_PASSWORD + SESSION_SECRET create it first.
# See docs/deploy.md#seed-and-local-commands.
# ---------------------------------------------------------------------------
# SEED_EMAIL=dev@opencv.me
# SEED_PASSWORD=correct-horse-battery
# SEED_NAME=Dev

# ---------------------------------------------------------------------------
# Coach (OpenRouter). Railway must set OPENROUTER_API_KEY on the api service
# in both staging and production. The entrypoint wires the real runtime only
# when the key is set. Missing key: app boots, POST /api/threads/:id/coach
# serves 503 COACH_UNAVAILABLE; GET /health is untouched. Defaults support
# User-selectable Free / Light / Max. Leave the mode vars unset
# to use the defaults. Set COACH_RUNTIME=fake to inject the scripted runtime
# (no API key) and exercise the owned SSE protocol: `curl -N` against the
# coach route. Never set COACH_RUNTIME=fake on production.
# See docs/deploy.md#coach.
# ---------------------------------------------------------------------------
# OPENROUTER_API_KEY=
# Local checks only: point the OpenRouter provider at a stub (http or https URL).
# OPENROUTER_BASE_URL=
# COACH_MODEL_FREE=openrouter/free
# COACH_MODEL_LIGHT=deepseek/deepseek-chat-v3.1
# COACH_MODEL_MAX=anthropic/claude-opus-4
# For Fable on Max: COACH_MODEL_MAX=anthropic/claude-fable-5
# COACH_DAILY_TURN_LIMIT_FREE=50
# COACH_DAILY_TURN_LIMIT_LIGHT=30
# COACH_DAILY_TURN_LIMIT_MAX=10
# COACH_RUNTIME=fake
#
# Manual eval harness (never CI). `pnpm --filter api eval` refuses without
# OPENROUTER_API_KEY. Run it before merging persona or prompt changes.
# Resolves the model through (`COACH_MODEL_FREE` / `_LIGHT` / `_MAX`).
# Optional: COACH_EVAL_MODE=free|light|max|all   (default free)
# Optional: COACH_EVAL_JUDGE_MODEL=openai/gpt-4o-mini
# Optional: COACH_EVAL_SCENARIO=move-starred-card
