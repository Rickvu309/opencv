# Web (Vite) — baked in at build time, so Vercel sets it per environment:
# production -> production API, preview -> staging API. See docs/deploy.md.
VITE_API_URL=http://localhost:3001

# Spec 3 placeholder profile until auth. Never the Eric Nguyen demo persona.
# VITE_DEV_PROFILE_NAME=Alex Tran
# VITE_DEV_PROFILE_EMAIL=you@openpath.app
# VITE_DEV_PROFILE_AVATAR=

# API
PORT=3001

# Browser origins the API accepts cross-host calls from (comma-separated).
# An entry may contain one `*`, which matches a single DNS label — that is how
# staging allows Vercel preview subdomains. See docs/railway.md.
WEB_ORIGINS=http://localhost:5173

# Postgres (Railway / local). Optional for GET /health and local `pnpm dev`;
# required to apply migrations (`pnpm --filter api run migrate` / Railway
# preDeploy). App tables live in the `openpath_app` schema.
# DATABASE_URL=postgresql://user:pass@localhost:5432/openpath
# DB_SCHEMA=openpath_app
#
# On Railway the api service gets DATABASE_URL for free via the shared
# reference DATABASE_URL=${{Postgres.DATABASE_URL}} (no credentials in git).
# See docs/railway.md for the project layout.

# Auth (Better Auth on the API). SESSION_SECRET must be at least 32 characters
# (`openssl rand -base64 32`). AUTH_URL is this API's public URL — https makes
# cookies SameSite=None; Secure. Railway sets both per environment.
# SESSION_SECRET=
# AUTH_URL=http://localhost:3001
#
# OPENROUTER_API_KEY=
