# Copy to `.env` or `.env.local`. Nothing here is a secret — fill real values
# locally and set the same names in Vercel / Railway. See docs/deploy.md and
# docs/railway.md.

# ---------------------------------------------------------------------------
# Web (Vite) — baked in at build time, so Vercel sets it per environment:
# production -> production API, preview -> staging API. See docs/deploy.md.
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# API process
# ---------------------------------------------------------------------------
PORT=3001

# Browser origins the API accepts cross-host calls from (comma-separated).
# An entry may contain one `*`, which matches a single DNS label — that is how
# staging allows Vercel preview subdomains. Unset = local web only.
# See docs/railway.md.
WEB_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Postgres (Railway / local)
# Optional for GET /health and local `pnpm dev`.
# Required to apply migrations (`pnpm --filter api run migrate` / Railway
# preDeploy) and to seed (`pnpm --filter api run seed`).
# App tables live in the `openpath_app` schema.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:pass@localhost:5432/openpath
# DB_SCHEMA=openpath_app
#
# On Railway the api service gets DATABASE_URL via the shared reference
# DATABASE_URL=${{Postgres.DATABASE_URL}} (no credentials in git).

# ---------------------------------------------------------------------------
# Auth (Better Auth on the API)
# SESSION_SECRET must be at least 32 characters (`openssl rand -base64 32`).
# AUTH_URL is this API's public URL — https makes cookies SameSite=None; Secure.
# Railway sets both per environment. Email verification is off; verify/reset
# links are logged until a Resend follow-up lands.
# ---------------------------------------------------------------------------
# SESSION_SECRET=
# AUTH_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Dev / staging seed (same starter workspace as signup; never on preDeploy)
# If SEED_EMAIL already exists, the script fills an empty account.
# If it does not, SEED_PASSWORD + SESSION_SECRET create it first.
# See docs/railway.md#dev--staging-seed.
# ---------------------------------------------------------------------------
# SEED_EMAIL=dev@openpath.app
# SEED_PASSWORD=correct-horse-battery
# SEED_NAME=Dev

# ---------------------------------------------------------------------------
# Coach (OpenRouter). The entrypoint wires the real runtime only when
# OPENROUTER_API_KEY is set. Missing key: app boots, POST /api/threads/:id/coach
# serves 503 COACH_UNAVAILABLE; GET /health is untouched. Defaults match ADR-0007.
# Set COACH_RUNTIME=fake to inject the scripted runtime (no API key) and
# exercise the owned SSE protocol: `curl -N` against the coach route.
# ---------------------------------------------------------------------------
# OPENROUTER_API_KEY=
# COACH_MODEL=anthropic/claude-sonnet-4.5
# COACH_DAILY_TURN_LIMIT=50
# COACH_RUNTIME=fake
