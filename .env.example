# Web (Vite)
VITE_API_URL=http://localhost:3001

# API
PORT=3001

# Postgres (Railway / local) — required once data layer lands
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# DB_SCHEMA=openpath_app
#
# On Railway the api service gets DATABASE_URL for free via the shared
# reference DATABASE_URL=${{Postgres.DATABASE_URL}} (no credentials in git).
# See docs/railway.md for the project layout.

# API secrets — required once auth / Coach LLM land
# SESSION_SECRET=
# OPENROUTER_API_KEY=
